{
  "version": 1,
  "sdk_version": "2.0.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "typing-pro",
      "version": "0.1.0",
      "title": "Typing Pro"
    },
    "tools": [
      {
        "name": "generate_passage",
        "title": "Generate typing passage",
        "description": "Generate a practice typing passage at easy, medium or hard difficulty, of roughly the requested length in characters.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "difficulty": {
              "default": "medium",
              "description": "Vocabulary and punctuation complexity of the passage.",
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            },
            "minChars": {
              "default": 320,
              "description": "Minimum number of characters in the passage.",
              "type": "integer",
              "minimum": 40,
              "maximum": 2000
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "analyze_typing",
        "title": "Analyze a typing attempt",
        "description": "Compare typed text against the target passage and return WPM, raw WPM, net WPM, accuracy, consistency and the most-missed keys.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "description": "The passage that should have been typed."
            },
            "typed": {
              "type": "string",
              "maxLength": 20000,
              "description": "What the typist actually entered."
            },
            "elapsedSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3600,
              "description": "How long the attempt took, in seconds."
            },
            "perSecondCorrect": {
              "description": "Optional cumulative correct-character counts sampled once per second.",
              "maxItems": 3600,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "required": [
            "target",
            "typed",
            "elapsedSeconds"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
